$("#perks").innerHTML=[["🎯","دوره‌های متنوع","برای همه سطوح"],["🧪","آموزش کاربردی","و پروژه‌محور"],["📝","ثبت‌نام آسان","با فرم درخواست"],["📼","فایل ضبط‌شده","در دوره‌های دارای این امکان"],["💬","پشتیبانی","آموزشی"]].map(a=>`<div class="it"><div class="ic">${a[0]}</div><b>${a[1]}</b><small>${a[2]}</small></div>`).join("");
$("#cat").innerHTML=CATS.map(c=>`<option>${c}</option>`).join("");
const price=c=>c.p?`<span class="old">${fa(c.o)}</span><span class="pr">${fa(c.p)} تومان</span><span class="dis">٪${fa(Math.round(100-c.p/c.o*100))} تخفیف</span>`:`<span class="pr">قیمت: به‌زودی اعلام می‌شود</span>`;
function draw(){const q=$("#q").value.trim().toLowerCase(),cat=$("#cat").value;
 const cs=COURSES.filter(c=>(c.t+c.d).toLowerCase().includes(q));
 $("#cl").innerHTML=cs.map(c=>`<div class="cc"><div class="im">${c.b?`<span class="bd">${c.b}</span>`:""}<img src="${IM[c.id]}" alt=""></div><div class="cb"><h3>${c.t}</h3><p>${c.n} · ${c.m}</p><div>${price(c)}</div><div class="row"><button class="btn o2" onclick="det('${c.id}')">اطلاعات بیشتر</button><button class="btn" onclick="reg('${c.id}')">ثبت‌نام در دوره</button></div></div></div>`).join("");
 $("#em").hidden=cs.length>0;
 const pf=PR.filter(p=>!p.free&&(p.t+(p.d||"")).toLowerCase().includes(q)&&(cat==CATS[0]||p.c==cat));
 $("#plw").innerHTML=pf.map(p=>`<div class="pc"><span class="tag">${p.c}</span><h3>${p.t}</h3><p>${p.d}</p><button class="btn" onclick="sup()">درخواست خرید</button></div>`).join("")||'<p class="sub">موردی نیست.</p>';
 $("#fl").innerHTML=PR.map((p,i)=>[p,i]).filter(([p])=>p.free&&(p.t+p.txt).toLowerCase().includes(q)).map(([p,i])=>`<div class="pc"><span class="tag">${p.c}</span><h3>${p.t}</h3><pre>${esc(p.txt)}</pre><button class="btn o2" data-cp="${i}">کپی پرامپت</button></div>`).join("")||'<p class="sub">موردی نیست.</p>'}
$("#q").oninput=draw;$("#cat").onchange=draw;$("#qc").onclick=()=>{$("#q").value="";draw()};$("#seeall").onclick=()=>$("#plw").scrollIntoView({behavior:"smooth"});
document.addEventListener("click",async e=>{const i=e.target.dataset.cp;if(i==null)return;try{await navigator.clipboard.writeText(PR[i].txt);e.target.textContent="کپی شد ✓"}catch{e.target.textContent="کپی ممکن نشد"}setTimeout(()=>e.target.textContent="کپی پرامپت",1800)});
window.det=id=>{const c=COURSES.find(x=>x.id==id);modal(`<h3>${c.t}</h3><p>${c.d}</p><p>جلسات: ${c.n}<br>برگزاری: ${c.m}</p>${c.f.length?"<ul>"+c.f.map(f=>`<li>${f}</li>`).join("")+"</ul>":"<p>سایر امکانات: در حال تکمیل</p>"}<p>${price(c)}</p><button class="btn" onclick="reg('${c.id}')">ثبت درخواست ثبت‌نام</button>`)};
window.sup=()=>modal('<h3>پشتیبانی آی‌هوش</h3><p>شناسه ایتا: <b dir="ltr">admin00097</b></p><p>کانال: <a href="https://eitaa.com/hoosh_a_i" target="_blank" rel="noopener">@hoosh_a_i</a></p>');
$("#sup").onclick=sup;$("#sup2").onclick=e=>{e.preventDefault();sup()};
$("#pv").onclick=e=>{e.preventDefault();modal("<h3>حریم خصوصی</h3><p>شماره تماس شما فقط برای پیگیری درخواست ثبت‌نام استفاده می‌شود و در سایت نمایش عمومی ندارد.</p>")};
// storage: Supabase if configured, else this browser only
async function save(row){if(ON){const r=await fetch(CONFIG.SUPABASE_URL+"/rest/v1/registrations",{method:"POST",headers:{apikey:CONFIG.SUPABASE_ANON_KEY,Authorization:"Bearer "+CONFIG.SUPABASE_ANON_KEY,"Content-Type":"application/json",Prefer:"return=minimal"},body:JSON.stringify(row)});if(!r.ok)throw 0}else{const a=LS.g("regs",[]);a.unshift({...row,id:Date.now(),created_at:new Date().toISOString()});LS.s("regs",a)}}
let busy=false;
window.reg=id=>{modal(`<h3>درخواست ثبت‌نام</h3>${ON?"":'<div class="msg wa">حالت آزمایشی: اطلاعات فقط در همین مرورگر ذخیره می‌شود.</div>'}
<form id="f"><input name="fn" placeholder="نام" required><input name="ln" placeholder="نام خانوادگی" required><input name="ph" type="tel" inputmode="numeric" dir="ltr" placeholder="09123456789" required>
<select name="co">${COURSES.map(x=>`<option ${x.id==id?"selected":""}>${x.t}</option>`).join("")}</select><textarea name="nt" rows="2" placeholder="توضیحات (اختیاری)"></textarea>
<input name="hp" style="display:none" tabindex="-1" autocomplete="off"><label><input type="checkbox" required style="width:auto"> سیاست حفظ حریم خصوصی را می‌پذیرم.</label>
<button class="btn">ارسال درخواست</button><div id="r"></div></form><p style="font-size:12px;color:#5b6690">ثبت درخواست به معنای پرداخت یا تأیید نهایی نیست.</p>`);
$("#f").onsubmit=async ev=>{ev.preventDefault();if(busy)return;const d=Object.fromEntries(new FormData(ev.target)),r=$("#r");if(d.hp)return;
 const ph=d.ph.replace(/[۰-۹]/g,x=>"۰۱۲۳۴۵۶۷۸۹".indexOf(x)).replace(/\D/g,"");
 if(!/^(09\d{9}|989\d{9})$/.test(ph)){r.className="msg er";r.textContent="شماره موبایل معتبر نیست.";return}
 busy=true;try{await save({first_name:d.fn.trim().slice(0,60),last_name:d.ln.trim().slice(0,60),phone:ph,course:d.co,note:d.nt.slice(0,500),status:"در انتظار تماس"});
 r.className="msg ok";r.textContent="درخواست شما با موفقیت ثبت شد. اطلاعات شما برای پیگیری ثبت‌نام در دوره انتخاب‌شده ذخیره شد. تیم آی‌هوش با شما ارتباط خواهد گرفت.";ev.target.querySelector("button").disabled=true}
 catch{r.className="msg er";r.textContent="ثبت انجام نشد؛ دوباره تلاش کنید."}busy=false}};
// reviews: pending until admin approval (local)
function rv(){const a=LS.g("rvs",[]).filter(x=>x.ok);$("#rl").innerHTML=a.length?a.map(x=>`<div class="card"><b>${esc(x.n)}</b> ${"★".repeat(x.s)}<p>${esc(x.t)}</p></div>`).join(""):'<div class="card">هنوز نظری تأیید نشده است.</div>'}
$("#rf").onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target)),a=LS.g("rvs",[]);a.push({n:d.n.slice(0,40),s:+d.s,t:d.t.slice(0,400),ok:false});LS.s("rvs",a);e.target.reset();$("#rr").className="msg ok";$("#rr").textContent="نظر شما ثبت شد و پس از تأیید مدیر نمایش داده می‌شود."};
$("#nf").onsubmit=e=>{e.preventDefault();const a=LS.g("news",[]);a.push($("#nf").e.value.slice(0,80));LS.s("news",a);$("#nr").textContent="عضویت ثبت شد ✓"};
// admin: registrations only
$("#adm").onclick=e=>{e.preventDefault();modal(`<h3>ورود مدیر</h3><form id="lf"><input name="p" type="password" placeholder="رمز عبور" required>${ON?'<input name="e" type="email" dir="ltr" placeholder="ایمیل">':""}<button class="btn">ورود</button><div id="lr"></div></form>`);
 $("#lf").onsubmit=async ev=>{ev.preventDefault();const d=Object.fromEntries(new FormData(ev.target));
  try{if(ON){const r=await fetch(CONFIG.SUPABASE_URL+"/auth/v1/token?grant_type=password",{method:"POST",headers:{apikey:CONFIG.SUPABASE_ANON_KEY,"Content-Type":"application/json"},body:JSON.stringify({email:d.e,password:d.p})});const j=await r.json();if(!j.access_token)throw 0;panel(await (await fetch(CONFIG.SUPABASE_URL+"/rest/v1/registrations?select=*&order=created_at.desc",{headers:{apikey:CONFIG.SUPABASE_ANON_KEY,Authorization:"Bearer "+j.access_token}})).json())}
  else{if(d.p!=="12345678910")throw 0;panel(LS.g("regs",[]))}}catch{$("#lr").className="msg er";$("#lr").textContent="ورود ناموفق بود."}}};
function panel(rows){modal(`<h3>افراد ثبت‌نام‌شده (${fa(rows.length)})</h3>${ON?"":'<div class="msg wa">فقط درخواست‌های ثبت‌شده در همین مرورگر. برای دیدن درخواست همه کاربران Supabase را وصل کنید.</div>'}<div class="sc"><table><tr><th>نام</th><th>تلفن</th><th>دوره</th><th>زمان</th></tr>${rows.map(x=>`<tr><td>${esc(x.first_name)} ${esc(x.last_name)}</td><td dir="ltr">${esc(x.phone)}</td><td>${esc(x.course)}</td><td>${new Date(x.created_at).toLocaleString("fa-IR")}</td></tr>`).join("")||'<tr><td colspan="4">درخواستی نیست</td></tr>'}</table></div>`)}
$("#top").onclick=()=>scrollTo({top:0});
const io=new IntersectionObserver(es=>es.forEach(x=>x.isIntersecting&&x.target.classList.add("in")),{threshold:.12});document.querySelectorAll(".rev").forEach(e=>io.observe(e));
draw();rv();
</script>
</body>
</html>
